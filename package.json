{
  "name": "@rafifos/plugin-heronite",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Punktfunk plugin: publishes Heronite's games to the host's library and starts them through Heronite.",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/rafifos/punktfunk-plugin-heronite",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafifos/punktfunk-plugin-heronite.git"
  },
  "keywords": [
    "punktfunk",
    "plugin",
    "heronite",
    "game-library",
    "game-streaming"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "bin": {
    "punktfunk-plugin-heronite": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "punktfunk": {
    "schema": 1,
    "id": "heronite",
    "reads": [
      "~/.local/share/heronite",
      "~/.var/app/app.heronite.Heronite/data/heronite"
    ],
    "files": [
      "~/AppData/Roaming/heronite/data"
    ],
    "exec": {
      "run": {
        "exe": "heronite-rs",
        "args": [
          "--no-gui",
          "--launch",
          "{runner}",
          "{appName}"
        ],
        "params": {
          "runner": "id",
          "appName": "name"
        }
      },
      "run-program": {
        "exe": "{program}",
        "args": [
          "--no-gui",
          "--launch",
          "{runner}",
          "{appName}"
        ],
        "params": {
          "program": "path",
          "runner": "id",
          "appName": "name"
        }
      },
      "run-flatpak": {
        "exe": "flatpak",
        "args": [
          "run",
          "app.heronite.Heronite",
          "--no-gui",
          "--launch",
          "{runner}",
          "{appName}"
        ],
        "params": {
          "runner": "id",
          "appName": "name"
        }
      },
      "open": {
        "exe": "xdg-open",
        "args": [
          "{url}"
        ],
        "params": {
          "url": "name"
        }
      },
      "open-windows": {
        "exe": "explorer.exe",
        "args": [
          "{url}"
        ],
        "params": {
          "url": "name"
        }
      },
      "window": {
        "exe": "heronite-rs",
        "args": []
      },
      "window-program": {
        "exe": "{program}",
        "args": [],
        "params": {
          "program": "path"
        }
      },
      "window-flatpak": {
        "exe": "flatpak",
        "args": [
          "run",
          "app.heronite.Heronite"
        ]
      },
      "console": {
        "exe": "heronite-rs",
        "args": [
          "--console",
          "--fullscreen"
        ]
      },
      "console-program": {
        "exe": "{program}",
        "args": [
          "--console",
          "--fullscreen"
        ],
        "params": {
          "program": "path"
        }
      },
      "console-flatpak": {
        "exe": "flatpak",
        "args": [
          "run",
          "app.heronite.Heronite",
          "--console",
          "--fullscreen"
        ]
      }
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts src/cli.ts --target=bun --outdir dist --external effect --external '@punktfunk/*'",
    "prepublishOnly": "bun run build",
    "check": "biome check --write --unsafe ."
  },
  "dependencies": {
    "@punktfunk/host": "^0.6.0",
    "@punktfunk/plugin-kit": "0.15.0",
    "effect": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/bun": "^1.4.5",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  }
}
